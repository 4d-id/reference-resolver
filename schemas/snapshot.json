{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4did.org/schemas/2.3/snapshot.json",
  "title": "Snapshot",
  "description": "One coherent picture across zones (Part 4, 16.5).",
  "type": "object",
  "properties": {
    "snapshot_id": { "type": "string" },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "zone": { "type": "string" }, "generation": { "type": "integer", "minimum": 0 } },
        "required": ["zone", "generation"],
        "additionalProperties": false
      }
    },
    "reference_time": { "$ref": "common.json#/$defs/instant" },
    "max_skew_s": { "type": "number", "minimum": 0 },
    "staleness_s": { "type": "number", "minimum": 0 }
  },
  "required": ["snapshot_id", "zones", "reference_time", "max_skew_s"],
  "additionalProperties": false
}
