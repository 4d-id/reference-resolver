{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4did.org/schemas/2.4/common.json",
  "$comment": "4D-ID 2.4, November 3, 2026. Working draft offered for community review; partial JSON binding, see encoding/2.4.md.",
  "title": "4D-ID common definitions",
  "$defs": {
    "fourdid": {
      "type": "string",
      "description": "Canonical 4D-ID URI (Part 1, 7.2). Legacy spatial variants retain their genesis rules. Variant id uses an opaque non-spatial home token, a UUIDv4/entropy descriptor, and no vertical reference or genesis timestamp. Shape checks do not prove entropy, privacy, UUID version, or normalization.",
      "allOf": [{
        "if": { "pattern": "^4did:id:" },
        "then": { "pattern": "^4did:id:[A-Za-z0-9.-]{1,64}:[A-Za-z0-9_-]{22,86}$" }
      }],
      "pattern": "^4did:[A-Za-z0-9]{1,8}:(?:[A-Za-z0-9_-]{22,86}\\.)?[A-Za-z0-9.-]{1,64}(?:;v=[A-Za-z0-9.-]{1,40})?:[A-Za-z0-9_-]{22,86}(?::[0-9]{8}T[0-9]{6}(?:\\.[0-9]{1,6})?Z)?$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 instant with UTC offset (Part 1, 5.2)."
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "quaternion": {
      "type": "array",
      "description": "Unit quaternion, order (x, y, z, w), Hamilton convention (Part 1, 5.2).",
      "items": { "type": "number" },
      "minItems": 4, "maxItems": 4
    },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "anchor": {
      "type": "object",
      "description": "Current DGGS anchor (Part 1, 7.3).",
      "properties": {
        "variant": { "type": "string", "not": { "const": "id" }, "description": "Spatial grid variant: h3, s2, isea3h, or oct for a virtual domain. The identifier mode id is not a grid." },
        "cell": { "type": "string" },
        "resolution": { "type": "integer", "minimum": 0 },
        "vref": { "type": "string", "description": "Vertical datum or floor reference (Part 1, 7.2)." }
      },
      "required": ["variant", "cell", "resolution"],
      "additionalProperties": false
    },
    "pose": {
      "type": "object",
      "description": "GeoPose-compatible transform from the entity local frame to its composition parent, or to the named frame when used by a registration (Part 1, 7.3, 8).",
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "orientation": { "$ref": "#/$defs/quaternion" },
        "scale": { "type": "number", "exclusiveMinimum": 0, "description": "Optional uniform scale (Part 1, 7.7)." }
      },
      "required": ["position", "orientation"],
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "description": "Position covariance (upper triangular, m^2), orientation sigma (rad), confidence (Part 1, 7.8).",
      "properties": {
        "position_cov_upper": { "type": "array", "items": { "type": "number" }, "minItems": 6, "maxItems": 6 },
        "orientation_sigma_rad": { "type": "number", "minimum": 0 },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "description": "Externally supplied producer, method and evidence; optional registration, fused-state and agent-run attribution (Part 1, 7.8). Authority fields are not authentication or authorization proof.",
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1, "description": "Attributed responsible authority; verification is deployment policy under Clause 12 and 14.4." },
        "confidence": { "$ref": "#/$defs/confidence" },
        "method": { "type": "string", "minLength": 1 },
        "rms_m": { "type": "number", "minimum": 0 },
        "tier": { "type": "string", "enum": ["logical", "navigational", "metric"] },
        "registered": { "$ref": "#/$defs/instant" },
        "supporting_observations": { "type": "array", "items": { "type": "string" } },
        "fusion_authority": { "type": "string" },
        "fusion_model": { "type": "string" },
        "identity_confidence": { "$ref": "#/$defs/confidence" },
        "state_confidence": { "$ref": "#/$defs/confidence" },
        "agent_id": { "type": "string" },
        "agent_run_id": { "type": "string" },
        "task_id": { "type": "string" },
        "model": { "type": "string" },
        "input_snapshot": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "approval_status": { "type": "string", "enum": ["proposed", "approved", "rejected"] }
      },
      "required": ["producer", "method"],
      "dependentRequired": { "tier": ["registered"], "rms_m": ["registered"] },
      "allOf": [{
        "if": { "properties": { "tier": { "const": "metric" } }, "required": ["tier"] },
        "then": { "required": ["rms_m"] }
      }],
      "additionalProperties": false
    },
    "registration": {
      "type": "object",
      "description": "Externally supplied registration (Part 1, 7.3, 7.8). Never a composition edge or identity decision. The transform maps entity-local coordinates into frame. Missing transform is unknown, not identity. Validity ordering and acceptance require semantic checks.",
      "properties": {
        "frame": { "$ref": "#/$defs/fourdid" },
        "transform": { "$ref": "#/$defs/pose" },
        "tier": { "type": "string", "enum": ["logical", "navigational", "metric"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "valid_from": { "$ref": "#/$defs/instant" },
        "valid_to": { "$ref": "#/$defs/instant" },
        "provenance": {
          "allOf": [
            { "$ref": "#/$defs/provenance" },
            { "required": ["registered", "evidence_refs"], "properties": { "evidence_refs": { "minItems": 1, "items": { "minLength": 1 } } } }
          ]
        },
        "status": { "type": "string", "enum": ["proposed", "accepted", "rejected", "disputed", "superseded", "expired"] }
      },
      "required": ["frame", "tier", "confidence", "valid_from", "valid_to", "provenance", "status"],
      "allOf": [{
        "if": { "properties": { "tier": { "const": "metric" } }, "required": ["tier"] },
        "then": { "properties": { "provenance": { "required": ["rms_m"], "properties": { "tier": { "const": "metric" } } } } }
      }, {
        "if": { "properties": { "tier": { "const": "logical" } }, "required": ["tier"] },
        "then": { "properties": { "provenance": { "properties": { "tier": { "const": "logical" } } } } }
      }, {
        "if": { "properties": { "tier": { "const": "navigational" } }, "required": ["tier"] },
        "then": { "properties": { "provenance": { "properties": { "tier": { "const": "navigational" } } } } }
      }],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "description": "Human-readable label; never determines identity (Part 1, 7.9).",
      "properties": {
        "text": { "type": "string" },
        "lang": { "type": "string" },
        "source": { "type": "string" },
        "valid_from": { "$ref": "#/$defs/instant" },
        "valid_to": { "$ref": "#/$defs/instant" }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "description": "Typed relation with validity, confidence, provenance; never implies a transform (Part 1, 7.9).",
      "properties": {
        "type": { "type": "string", "description": "proxy_of | portal | corresponds_to | observed_by | represents | identified_as | taxonomy-namespaced" },
        "target": { "$ref": "#/$defs/fourdid" },
        "registry": { "type": "string" },
        "external_id": { "type": "string" },
        "kind": { "type": "string", "description": "For represents: pointcloud|splat|mesh|panorama|ifc|tileset." },
        "lod": { "type": "string" },
        "captured": { "$ref": "#/$defs/instant" },
        "license": { "type": "string" },
        "supersedes": { "$ref": "#/$defs/fourdid" },
        "valid_from": { "$ref": "#/$defs/instant" },
        "valid_to": { "$ref": "#/$defs/instant" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "required": ["type"],
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "identified_as" } } },
          "then": { "required": ["registry", "external_id"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["proxy_of", "portal", "corresponds_to", "observed_by", "represents"] } } },
          "then": { "required": ["target"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
