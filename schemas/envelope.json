{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4did.org/schemas/2.3/envelope.json",
  "title": "Context envelope",
  "description": "Bounded, deterministic agent-facing description of one entity (Part 2, 10.6).",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.json#/$defs/fourdid" },
    "class": { "type": "string" },
    "labels": { "type": "array", "items": { "$ref": "common.json#/$defs/label" } },
    "parent": { "$ref": "common.json#/$defs/fourdid" },
    "pose": { "$ref": "common.json#/$defs/pose" },
    "as_of": { "$ref": "common.json#/$defs/instant" },
    "snapshot_id": { "type": "string" },
    "uncertainty": { "$ref": "common.json#/$defs/uncertainty" },
    "affordances": { "type": "array", "items": { "type": "string" } },
    "hull": { "type": "object", "additionalProperties": true },
    "relations": { "type": "array", "items": { "$ref": "common.json#/$defs/relation" } },
    "representations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": { "$ref": "common.json#/$defs/fourdid" },
          "kind": { "type": "string" },
          "tier": { "type": "string", "enum": ["logical", "navigational", "metric"] },
          "license": { "type": "string" }
        },
        "required": ["target", "kind"],
        "additionalProperties": false
      }
    },
    "provenance": { "$ref": "common.json#/$defs/provenance" },
    "freshness_s": { "type": "number", "minimum": 0 },
    "constraints": { "type": "object", "additionalProperties": true, "description": "Disclosure and license constraints applying to the requester." }
  },
  "required": ["id", "snapshot_id"],
  "additionalProperties": false
}
